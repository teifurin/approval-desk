# Custom health check message
PING_MESSAGE=pong

# Lets external agents (Claude Code and others) connect to /mcp. Generate your
# own random value, e.g. `openssl rand -hex 32`, and send it as a Bearer token.
# ACCESS_TOKEN=
# The person whose inbox external agents file requests into: the email you sign
# up with.
# AGENT_NATIVE_OWNER_EMAIL=you@example.com
# Turns off the no-password "Continue as local dev" sign-in. Set this whenever
# external agents can connect, or any process on this machine could get a session
# and approve its own requests. Sign up on the welcome page instead.
# AGENT_NATIVE_DISABLE_AUTO_DEV_ACCOUNT=1

# Optional: bring your own model key instead of connecting Builder.io in the app.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
